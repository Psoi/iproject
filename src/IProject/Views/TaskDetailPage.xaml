<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IProject.Views.TaskDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:IProject.Models"
    xmlns:views="clr-namespace:IProject.Views"
    xmlns:vm="clr-namespace:IProject.ViewModels"
    Title="Task"
    x:DataType="vm:TaskDetailViewModel"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,40">

            <!-- Title -->
            <Editor
                AutoSize="TextChanges"
                FontFamily="OpenSansSemibold"
                FontSize="20"
                Placeholder="Title"
                PlaceholderColor="{StaticResource TextSecondary}"
                Text="{Binding Title}"
                TextColor="{StaticResource TextPrimary}" />

            <Label Style="{StaticResource SectionHeader}" Text="TYPE" />
            <views:SegmentedControl
                OptionColors="{Binding TypeColors}"
                Options="{Binding TypeOptions}"
                SelectedIndex="{Binding TypeIndex}" />

            <Label Style="{StaticResource SectionHeader}" Text="STATUS" />
            <views:SegmentedControl
                OptionColors="{Binding StatusColors}"
                Options="{Binding StatusOptions}"
                SelectedIndex="{Binding StatusIndex}" />

            <Label Style="{StaticResource SectionHeader}" Text="PRIORITY" />
            <views:SegmentedControl
                OptionColors="{Binding PriorityColors}"
                Options="{Binding PriorityOptions}"
                SelectedIndex="{Binding PriorityIndex}" />

            <!-- Due date -->
            <Label Style="{StaticResource SectionHeader}" Text="DUE DATE" />
            <Button
                Command="{Binding SetDueDateCommand}"
                HorizontalOptions="Start"
                IsVisible="{Binding HasDueDate, Converter={StaticResource InvertedBool}}"
                Style="{StaticResource OutlineButton}"
                Text="+ Set due date" />
            <HorizontalStackLayout IsVisible="{Binding HasDueDate}" Spacing="8">
                <DatePicker
                    Date="{Binding DueDate}"
                    FontSize="16"
                    Format="ddd, d MMM yyyy"
                    TextColor="{StaticResource TextPrimary}"
                    VerticalOptions="Center">
                    <DatePicker.Triggers>
                        <DataTrigger
                            Binding="{Binding IsOverdue}"
                            TargetType="DatePicker"
                            Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                        </DataTrigger>
                    </DatePicker.Triggers>
                </DatePicker>
                <Label
                    FontSize="13"
                    IsVisible="{Binding IsOverdue}"
                    Text="Overdue"
                    TextColor="{StaticResource Danger}"
                    VerticalOptions="Center" />
                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding ClearDueDateCommand}"
                    Text="Clear"
                    TextColor="{StaticResource TextSecondary}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Description -->
            <Label Style="{StaticResource SectionHeader}" Text="DESCRIPTION" />
            <Border
                Padding="8,0"
                BackgroundColor="{StaticResource Surface}"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0">
                <Editor
                    AutoSize="TextChanges"
                    MinimumHeightRequest="90"
                    Placeholder="Add details…"
                    PlaceholderColor="{StaticResource TextSecondary}"
                    Text="{Binding Description}"
                    TextColor="{StaticResource TextPrimary}" />
            </Border>

            <!-- Checklist -->
            <Label Style="{StaticResource SectionHeader}" Text="{Binding ChecklistSummary}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Checklist}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChecklistRow">
                        <Grid ColumnDefinitions="Auto,*,Auto" MinimumHeightRequest="44">
                            <CheckBox
                                IsChecked="{Binding IsDone}"
                                VerticalOptions="Center"
                                Color="{StaticResource Accent}" />
                            <Label
                                Grid.Column="1"
                                FontSize="15"
                                Text="{Binding Text}"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsDone}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Button
                                Grid.Column="2"
                                Padding="0"
                                BackgroundColor="Transparent"
                                Command="{Binding DeleteChecklistItemCommand, Source={RelativeSource AncestorType={x:Type vm:TaskDetailViewModel}}, x:DataType=vm:TaskDetailViewModel}"
                                CommandParameter="{Binding .}"
                                FontSize="16"
                                Text="✕"
                                TextColor="{StaticResource TextSecondary}"
                                WidthRequest="40" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry
                    Placeholder="Add a step…"
                    ReturnCommand="{Binding AddChecklistItemCommand}"
                    ReturnType="Done"
                    Style="{StaticResource FieldEntry}"
                    Text="{Binding NewChecklistText}" />
                <Button
                    Grid.Column="1"
                    Command="{Binding AddChecklistItemCommand}"
                    Style="{StaticResource OutlineButton}"
                    Text="Add" />
            </Grid>

            <!-- Attachments -->
            <Label Style="{StaticResource SectionHeader}" Text="ATTACHMENTS" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Attachments}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Attachment">
                        <Border
                            BackgroundColor="{StaticResource Surface}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <views:PressableGrid
                                Padding="8"
                                ColumnDefinitions="48,*"
                                ColumnSpacing="12"
                                Command="{Binding OpenAttachmentCommand, Source={RelativeSource AncestorType={x:Type vm:TaskDetailViewModel}}, x:DataType=vm:TaskDetailViewModel}"
                                CommandParameter="{Binding .}"
                                LongPressCommand="{Binding ShowAttachmentMenuCommand, Source={RelativeSource AncestorType={x:Type vm:TaskDetailViewModel}}, x:DataType=vm:TaskDetailViewModel}"
                                RowDefinitions="Auto,Auto">
                                <Border
                                    Grid.RowSpan="2"
                                    BackgroundColor="{StaticResource SurfaceHigh}"
                                    HeightRequest="48"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="0"
                                    WidthRequest="48">
                                    <Grid>
                                        <Label
                                            FontSize="18"
                                            HorizontalOptions="Center"
                                            Text="📄"
                                            VerticalOptions="Center" />
                                        <Image
                                            Aspect="AspectFill"
                                            IsVisible="{Binding IsImage}"
                                            Source="{Binding FullPath}" />
                                    </Grid>
                                </Border>
                                <Label
                                    Grid.Column="1"
                                    FontSize="15"
                                    LineBreakMode="MiddleTruncation"
                                    Text="{Binding FileName}"
                                    TextColor="{StaticResource TextPrimary}"
                                    VerticalOptions="End" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="12"
                                    Text="{Binding Details}"
                                    TextColor="{StaticResource TextSecondary}" />
                            </views:PressableGrid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <HorizontalStackLayout Margin="0,8,0,0" Spacing="8">
                <Button
                    Command="{Binding AddPhotoCommand}"
                    Style="{StaticResource OutlineButton}"
                    Text="+ Photo" />
                <Button
                    Command="{Binding AddFileCommand}"
                    Style="{StaticResource OutlineButton}"
                    Text="+ File" />
            </HorizontalStackLayout>

            <!-- Comments -->
            <Label Style="{StaticResource SectionHeader}" Text="COMMENTS" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Comments}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Comment">
                        <Border
                            BackgroundColor="{StaticResource Surface}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <views:PressableGrid
                                Padding="12,10"
                                LongPressCommand="{Binding ShowCommentMenuCommand, Source={RelativeSource AncestorType={x:Type vm:TaskDetailViewModel}}, x:DataType=vm:TaskDetailViewModel}"
                                CommandParameter="{Binding .}"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="4">
                                <Label
                                    FontSize="12"
                                    Text="{Binding Timestamp}"
                                    TextColor="{StaticResource TextSecondary}" />
                                <Label
                                    Grid.Row="1"
                                    FontSize="15"
                                    Text="{Binding Text}"
                                    TextColor="{StaticResource TextPrimary}" />
                            </views:PressableGrid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Grid
                Margin="0,4,0,0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <Editor
                    AutoSize="TextChanges"
                    Placeholder="Write a comment…"
                    PlaceholderColor="{StaticResource TextSecondary}"
                    Text="{Binding NewComment}"
                    TextColor="{StaticResource TextPrimary}" />
                <Button
                    Grid.Column="1"
                    Command="{Binding PostCommentCommand}"
                    Style="{StaticResource OutlineButton}"
                    Text="Post"
                    VerticalOptions="End" />
            </Grid>

            <!-- Delete -->
            <Button
                Margin="0,36,0,0"
                BackgroundColor="Transparent"
                BorderColor="{StaticResource Danger}"
                BorderWidth="1"
                Command="{Binding DeleteTaskCommand}"
                CornerRadius="20"
                Text="Delete task"
                TextColor="{StaticResource Danger}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
